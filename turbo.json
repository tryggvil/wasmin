{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "component/**"],
      "passThroughEnv": ["GITHUB_TOKEN"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "test": {
      "passThroughEnv": ["GITHUB_TOKEN"]
    }
  }
}
